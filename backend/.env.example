# Backend Environment Variables
# If left blank, the backend runs in standalone dev fallback mode with DuckDB & In-Memory Redis.

PORT=8080
ENVIRONMENT=production
ALLOWED_ORIGINS="*"
USE_IN_MEMORY_REDIS_FALLBACK=true
USE_DUCKDB_FALLBACK=true
USE_DEV_AUTH_FALLBACK=true
SECRET_KEY="smart-market-watchlist-secret-key-2026-production-ready"

# Optional: Real Firebase Admin SDK Credentials
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CREDENTIALS_PATH="/path/to/service-account.json"
